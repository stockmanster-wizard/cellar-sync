{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "provider": { "type": "string", "enum": ["google", "password"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "provider"]
    },
    "Bottle": {
      "title": "Bottle",
      "description": "A bottle stored in the cellar or consumed",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "producer": { "type": "string", "maxLength": 256 },
        "wineName": { "type": "string", "maxLength": 256 },
        "varietal": { "type": "string", "maxLength": 128 },
        "vintage": { "type": "string", "maxLength": 32 },
        "style": { "type": "string", "maxLength": 64 },
        "country": { "type": "string", "maxLength": 128 },
        "region": { "type": "string", "maxLength": 256 },
        "alcoholPercent": { "type": "number" },
        "slotId": { "type": "string", "maxLength": 128 },
        "previousSlotId": { "type": "string", "maxLength": 128 },
        "imageUrl": { "type": "string", "maxLength": 800000 },
        "status": { "type": "string", "enum": ["in-cellar", "staging", "consumed"] },
        "addedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "consumedAt": { "type": "string", "maxLength": 64 },
        "tastingNotes": { "type": "string", "maxLength": 4000 },
        "rating": { "type": "number" },
        "drinkingWindow": { "type": "string", "maxLength": 128 },
        "referenceProfile": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "maxLength": 128 },
            "notes": { "type": "string", "maxLength": 4000 }
          }
        },
        "cellarNotes": { "type": "string", "maxLength": 2000 },
        "consumption": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "maxLength": 64 },
            "rating": { "type": "number" },
            "tastingNotes": { "type": "string", "maxLength": 4000 }
          }
        }
      },
      "required": ["id", "user_id", "producer", "vintage", "style", "country", "region", "status", "addedAt"]
    },
    "StorageUnit": {
      "title": "StorageUnit",
      "description": "A storage rack or shelf in the cellar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "columns": { "type": "number" },
        "rows": { "type": "number" },
        "is_staging": { "type": "boolean" },
        "sort_order": { "type": "number" }
      },
      "required": ["id", "user_id", "name", "columns", "rows", "is_staging", "sort_order"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/bottles/{bottleId}": {
      "schema": "Bottle",
      "description": "User's cellar bottle inventory"
    },
    "/users/{userId}/storageUnits/{unitId}": {
      "schema": "StorageUnit",
      "description": "User's storage racks and staging shelf"
    }
  }
}
